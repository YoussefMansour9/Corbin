# ---------------------------------------------------------------------------
# Supabase (lead storage)
# Dashboard > Project Settings > API
#
# These are NOT prefixed with NEXT_PUBLIC_ on purpose. The service role key
# bypasses Row Level Security and must never be sent to the browser.
# ---------------------------------------------------------------------------
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Any random string. Salts the IP hash used for rate limiting so the stored
# hashes cannot be reversed with a rainbow table.
IP_HASH_SALT=

# ---------------------------------------------------------------------------
# EmailJS (notification emails). Client-side by design, so these are public.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_EMAILJS_SERVICE_ID=
NEXT_PUBLIC_EMAILJS_PUBLIC_KEY=
NEXT_PUBLIC_EMAILJS_BOOK_CONSULT_TEMPLATE_ID=
NEXT_PUBLIC_EMAILJS_HIRING_FORM_TEMPLATE_ID=
NEXT_PUBLIC_EMAILJS_ROOFING_FORM_TEMPLATE_ID=
