# ---------------------------------------------------------------------------
# Supabase (lead storage)
# Dashboard > Project Settings > API
#
# Not prefixed with NEXT_PUBLIC_ on purpose. The service role key bypasses
# Row Level Security and must never be sent to the browser.
# ---------------------------------------------------------------------------
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Any random string. Salts the IP hash used for rate limiting so the stored
# hashes cannot be reversed with a rainbow table.
IP_HASH_SALT=

# ---------------------------------------------------------------------------
# Resend (lead notification email). Server-side only.
#
# RESEND_FROM must use a domain verified on Resend. Until corbinstaffing.com
# is verified, Resend's shared sender is used, which only delivers to the
# Resend account owner's own address.
# ---------------------------------------------------------------------------
RESEND_API_KEY=
RESEND_FROM=Corbin Staffing <noreply@corbinstaffing.com>

# Who receives new lead notifications. Comma separated for multiple.
LEAD_NOTIFICATION_TO=
